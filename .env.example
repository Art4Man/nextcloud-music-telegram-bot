# nc-music-bot configuration
# Copy to `.env` and fill in. The bot reads this file from its working directory
# (or pass values as real environment variables — env vars win over .env).
# Lines starting with # are comments; example values reflect a typical
# snap-Nextcloud home server reached over Tailscale.

# ──────────────────────────── Telegram ────────────────────────────

# Bot token from @BotFather (required to run; the doctor `--check` works without it).
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to use the bot (required).
# Don't know yours? Start the bot and send /myid — it answers for anyone.
ALLOWED_USER_IDS=

# Comma-separated bot @usernames whose audio should be auto-relayed (optional).
# Example: a Spotify downloader bot that posts MP3s in a shared group.
# Requires Bot-to-Bot Communication Mode enabled in @BotFather AND the bot
# either made a group admin or with Group Privacy Mode disabled — otherwise
# Telegram won't deliver other bots' messages to your bot.
#SOURCE_BOT_USERNAMES=Spotify_downloaderrr_bot

# Both lists above can also be managed at runtime by admins via Telegram
# (/whitelist, /allow, /deny, /addbot, /rmbot). Admins = the IDs in
# ALLOWED_USER_IDS above. Set a path here to persist runtime changes across
# restarts (put it on a mounted volume for Docker); unset = in-memory only.
#WHITELIST_STORE_PATH=/data/whitelist.json

# Reject files larger than this many MB (guard for the large-file mode).
#MAX_FILE_MB=2000

# ─────────────── Large-file mode (optional, up to 2 GB) ───────────────
# Without this, the standard Bot API applies and downloads are capped at 20 MB.
# To unlock 2 GB, run the self-hosted `telegram-bot-api` helper (see
# docker-compose.yml, profile `large`) and point the bot at it:

#TELEGRAM_API_BASE_URL=http://127.0.0.1:8081

# These two are consumed by the telegram-bot-api helper container only
# (get them at https://my.telegram.org → API development tools):
#TELEGRAM_API_ID=
#TELEGRAM_API_HASH=

# ──────────────── Destination (reached over Tailscale) ────────────────

# Tailnet IP or MagicDNS name of the machine that hosts the music library.
# Example: 100.64.0.42  or  nextcloud-box.tailnet-1234.ts.net
DEST_HOST=

#DEST_SSH_PORT=22
DEST_SSH_USER=root

# Auth: an SSH private key is strongly recommended (see deploy/setup-ssh-key.sh).
DEST_SSH_KEY_PATH=
# Password auth works but is discouraged; only used if no key path is set.
#DEST_SSH_PASSWORD=

# Host-key checking: path to a known_hosts file. If unset, the bot pins the
# destination's host key on first connect (TOFU) and verifies it afterwards.
#DEST_KNOWN_HOSTS=

# Absolute directory on the destination where audio files are uploaded.
# Example (snap Nextcloud): /var/snap/nextcloud/common/nextcloud/data/admin/files/Music
DEST_PATH=

# ──────────────── Nextcloud scan (after each upload) ────────────────
# Disable for non-Nextcloud destinations (plain SFTP drop).

#RUN_SCAN=true

# occ command on the destination. Snap installs expose it as `nextcloud.occ`.
#NEXTCLOUD_OCC=nextcloud.occ

# Nextcloud user owning the library, and the path passed to `occ files:scan --path=`.
# Example: NEXTCLOUD_USER=admin  NEXTCLOUD_SCAN_PATH=admin/files/Music
NEXTCLOUD_USER=admin
NEXTCLOUD_SCAN_PATH=

# ──────────────────────────── Misc ────────────────────────────

# Where files are staged before upload (deleted right after each transfer).
#TEMP_DIR=/tmp/nc-music-bot

#LOG_LEVEL=INFO
